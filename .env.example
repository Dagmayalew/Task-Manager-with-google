# Gemini API key — from https://aistudio.google.com
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App URL — the URL where this app is hosted (e.g. http://localhost:3000 or your Vercel URL)
APP_URL="YOUR_APP_URL"

# Firebase config — from Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Google OAuth Client ID — from Google Cloud Console > APIs & Services > Credentials
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"
